+  assert.equal(config.allow_ad_personalization_signals, false);
+});
+
+test("settings allow withdrawal, removing only GA cookies and reloading", () => {
+  const state = browser({ saved: { value: "granted", at: Date.now() } });
+  assert.equal(state.scripts.length, 1);
+  state.settings.click();
+  assert.equal(state.banner.hidden, false);
+  assert.equal(state.buttons[1].focused, true);
+  state.buttons[1].click();
+  assert.equal(state.window["ga-disable-G-01JX9HZ5G9"], true);
+  assert.equal(state.location.reloaded, true);
+  assert.equal(state.cookies.length, 6);
