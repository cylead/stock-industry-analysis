+const measurementId = "G-01JX9HZ5G9";
+const consentKey = "svl-analytics-consent";
+const maxAge = 180 * 24 * 60 * 60 * 1000;
+
+if (location.hostname === "stockvaluelens.com") {
+  let consent = null;
+  let loaded = false;
+  try {
+    const saved = JSON.parse(localStorage.getItem(consentKey));
+    if (saved && Date.now() - saved.at < maxAge && ["granted", "denied"].includes(saved.value)) consent = saved.value;
+  } catch {}
+
+  const banner = document.createElement("section");
+  banner.className = "analytics-consent";
+  banner.setAttribute("aria-label", "Analytics privacy choice");
+  banner.innerHTML = `<div><strong>Help us improve Stock Value Lens</strong><p>Allow Google Analytics cookies to measure visits, pages viewed and engagement? Your choice does not affect access to the website. <a href="/privacy/">Privacy details</a></p></div><div class="analytics-actions"><button type="button" data-consent="granted">Accept analytics</button><button type="button" data-consent="denied">Reject analytics</button></div>`;
+  document.body.append(banner);
+
+  function startAnalytics() {
+    if (loaded) return;
+    loaded = true;
+    window.dataLayer = window.dataLayer || [];
+    window.gtag = function () { window.dataLayer.push(arguments); };
+    window.gtag("consent", "default", {
+      analytics_storage: "denied", ad_storage: "denied", ad_user_data: "denied", ad_personalization: "denied"
+    });
+    window.gtag("consent", "update", { analytics_storage: "granted" });
+    window.gtag("js", new Date());
+    window.gtag("config", measurementId, {
+      allow_google_signals: false,
+      allow_ad_personalization_signals: false,
+      page_location: location.origin + location.pathname,
+      page_referrer: document.referrer.split("?")[0].split("#")[0]
+    });
+    const tag = document.createElement("script");
+    tag.async = true;
+    tag.src = `https://www.googletagmanager.com/gtag/js?id=${measurementId}`;
+    document.head.append(tag);
+  }
+
+  function choose(value) {
+    consent = value;
+    try { localStorage.setItem(consentKey, JSON.stringify({ value, at: Date.now() })); } catch {}
+    banner.hidden = true;
+    if (value === "granted") startAnalytics();
+    else if (loaded) {
+      window[`ga-disable-${measurementId}`] = true;
+      for (const cookie of document.cookie.split(";")) {
+        const name = cookie.trim().split("=")[0];
+        if (name === "_ga" || name.startsWith("_ga_")) {
