+
+const source = await readFile(new URL("../web/analytics.js", import.meta.url), "utf8");
+function browser({ hostname = "stockvaluelens.com", saved = null, unavailable = false } = {}) {
+  const scripts = [], cookies = [], stored = new Map(saved ? [["svl-analytics-consent", JSON.stringify(saved)]] : []);
+  const buttons = ["granted", "denied"].map((value) => ({ dataset: { consent: value }, addEventListener(_, callback) { this.click = callback; }, focus() { this.focused = true; } }));
+  const settings = { hidden: true, addEventListener(_, callback) { this.click = callback; } };
+  const banner = { hidden: false, setAttribute() {}, querySelectorAll() { return buttons; }, querySelector() { return buttons[1]; } };
+  const document = { referrer: "https://example.org/link?email=private#anchor", head: { append(tag) { scripts.push(tag); } }, body: { append() {} }, createElement(name) { return name === "section" ? banner : {}; }, querySelectorAll() { return [settings]; } };
+  Object.defineProperty(document, "cookie", { get() { return "_ga=123; _ga_01JX9HZ5G9=456; other=retain"; }, set(value) { cookies.push(value); } });
+  const location = { hostname, origin: `https://${hostname}`, pathname: "/stocks/aapl/", reload() { this.reloaded = true; } };
+  const window = {};
+  const localStorage = { getItem(key) { if (unavailable) throw Error("blocked"); return stored.get(key) || null; }, setItem(key, value) { if (unavailable) throw Error("blocked"); stored.set(key, value); } };
+  vm.runInNewContext(source, { document, location, localStorage, window, Date });
+  return { scripts, cookies, stored, buttons, settings, banner, location, window };
+}
+
+test("no Google tag loads before consent or after rejection, including a later visit", () => {
+  const state = browser();
+  assert.equal(state.scripts.length, 0);
+  assert.equal(state.banner.hidden, false);
+  state.buttons[1].click();
+  assert.equal(state.scripts.length, 0);
+  assert.equal(state.banner.hidden, true);
+  const next = browser({ saved: JSON.parse(state.stored.get("svl-analytics-consent")) });
+  assert.equal(next.scripts.length, 0);
+  assert.equal(next.banner.hidden, true);
+});
+
+test("acceptance loads once, strips URL parameters, and keeps advertising denied", () => {
+  const state = browser();
+  state.buttons[0].click();
+  state.buttons[0].click();
+  assert.equal(state.scripts.length, 1);
+  assert.match(state.scripts[0].src, /G-01JX9HZ5G9$/);
