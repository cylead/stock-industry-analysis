+import test from "node:test";
+import assert from "node:assert/strict";
+import { annualPeHistory } from "../web/calculations.js";
+
+const annual = (date, basicEps, dilutedEps) => ({ periodEnd: date, basicEps, dilutedEps, sources: { eps_diluted: { filed: "2026-08-01" } } });
+test("Annual P/E uses eligible fiscal-year-end prices, preserves filing dates, and does not cap ratios", () => {
+  const rows = annualPeHistory({ annual: [annual("2024-12-31", 2, 1), annual("2025-12-31", 2, 0.5)], prices: [
+    { date: "2024-12-20", splitClose: 80, adjustedClose: 60 },
+    { date: "2024-12-27", adjustedClose: 70 },
+    { date: "2025-12-26", adjustedClose: 100 },
+    { date: "2026-01-02", splitClose: 999 }
+  ] });
+  assert.equal(rows[0].priceDate, "2024-12-20");
+  assert.equal(rows[0].priceType, "split_only_close");
+  assert.equal(rows[0].basicPe, 40); assert.equal(rows[0].dilutedPe, 80);
+  assert.equal(rows[1].priceDate, "2025-12-26");
+  assert.equal(rows[1].priceType, "stooq_adjusted_close");
+  assert.equal(rows[1].dilutedPe, 200);
+  assert.equal(rows[1].dilutedSource.filed, "2026-08-01");
+});
+test("Annual P/E leaves gaps for losses, zero or missing EPS, stale prices and future prices", () => {
+  const periods = [annual("2023-12-31", -1, 0), annual("2024-12-31", null, 1), annual("2025-12-31", 1, 2), annual("2026-12-31", 1, null)];
+  const rows = annualPeHistory({ annual: periods, prices: [
+    { date: "2023-12-29", adjustedClose: 20 }, { date: "2024-12-17", adjustedClose: 30 },
+    { date: "2025-12-16", adjustedClose: 40 }, { date: "2027-01-01", adjustedClose: 50 }
+  ] });
+  assert.equal(rows[0].basicPe, null); assert.equal(rows[0].dilutedPe, null);
+  assert.equal(rows[1].basicPe, null); assert.equal(rows[1].dilutedPe, 30); // 14-day boundary
+  assert.equal(rows[2].price, null); assert.equal(rows[2].dilutedPe, null); // 15 days stale
+  assert.equal(rows[3].price, null); assert.equal(rows[3].basicPe, null); // no future substitution
+});
