+import { annualPeHistory } from "./calculations.js";
+
+const NS = "http://www.w3.org/2000/svg";
+const node = (tag, attrs, text) => {
+  const element = document.createElementNS(NS, tag);
+  Object.entries(attrs).forEach(([key, value]) => element.setAttribute(key, value));
+  if (text !== undefined) element.textContent = text;
+  return element;
+};
+const number = (value) => value === null ? "Unavailable" : value.toFixed(2);
+let currentSnapshot, currentRange, rows;
+
+function download(blob, suffix) {
+  const link = document.createElement("a"), url = URL.createObjectURL(blob);
+  link.href = url;
+  link.download = `${currentSnapshot.company.ticker}-annual-pe-${document.querySelector("#pe-basis").value}.${suffix}`;
+  document.body.appendChild(link);
+  link.click();
+  link.remove();
+  setTimeout(() => URL.revokeObjectURL(url), 1000);
+}
+
+export function renderPeHistory(snapshot, range) {
+  currentSnapshot = snapshot;
+  currentRange = range;
+  const chart = document.querySelector("#pe-chart");
+  const basis = document.querySelector("#pe-basis");
+  if (!basis.dataset.bound) {
+    basis.dataset.bound = "true";
+    basis.addEventListener("change", () => renderPeHistory(currentSnapshot, currentRange));
+    document.querySelector("#pe-references").addEventListener("change", () => renderPeHistory(currentSnapshot, currentRange));
+    document.querySelector("#pe-csv").addEventListener("click", () => {
+      const lines = ["fiscal_end,price_date,price,price_type,basic_eps,diluted_eps,basic_pe,diluted_pe,basic_filing_date,diluted_filing_date"];
+      rows.forEach((row) => lines.push([row.date, row.priceDate, row.price, row.priceType, row.basicEps, row.dilutedEps, row.basicPe, row.dilutedPe, row.basicSource?.filed, row.dilutedSource?.filed].map((value) => value ?? "").join(",")));
+      download(new Blob([lines.join("\n")], { type: "text/csv;charset=utf-8" }), "csv");
+    });
+    document.querySelector("#pe-png").addEventListener("click", () => {
+      const image = new Image(), url = URL.createObjectURL(new Blob([new XMLSerializer().serializeToString(chart)], { type: "image/svg+xml" }));
+      image.onload = () => {
+        const canvas = document.createElement("canvas");
+        canvas.width = chart.viewBox.baseVal.width * 2; canvas.height = 680;
+        const context = canvas.getContext("2d");
+        context.fillStyle = "white"; context.fillRect(0, 0, canvas.width, canvas.height);
+        context.drawImage(image, 0, 0, canvas.width, canvas.height);
+        canvas.toBlob((blob) => download(blob, "png"));
+        URL.revokeObjectURL(url);
+      };
+      image.src = url;
+    });
+  }
+  rows = annualPeHistory(snapshot).filter((row) => (!range?.start || row.date >= range.start) && (!range?.end || row.date <= range.end));
+  const series = [["diluted", "dilutedPe", "#23634b"], ["basic", "basicPe", "#ce8746"]].filter(([key]) => basis.value === "both" || basis.value === key);
+  const references = document.querySelector("#pe-references").checked;
+  const values = rows.flatMap((row) => series.map(([, key]) => row[key])).filter((value) => value !== null);
+  chart.textContent = "";
+  const width = Math.max(320, chart.clientWidth), right = width - 20;
+  chart.setAttribute("viewBox", `0 0 ${width} 340`);
+  chart.setAttribute("xmlns", NS);
+  chart.appendChild(node("title", {}, `${snapshot.company.ticker} approximate fiscal-year-end P/E history (${basis.value})`));
+  chart.appendChild(node("rect", { width, height: 340, fill: "white" }));
+  chart.appendChild(node("text", { x: 60, y: 22, fill: "#182923", "font-size": 12 }, `${snapshot.company.ticker} · Annual P/E (${basis.value}) · approx.`));
+  const maximum = Math.max(...values, references && values.length ? 30 : 1) * 1.1;
+  const first = Date.parse(range?.start || rows[0]?.date), last = Date.parse(range?.end || rows.at(-1)?.date);
+  const x = (date) => 60 + (Date.parse(date) - first) / Math.max(1, last - first) * (right - 60);
+  const y = (value) => 280 - value / maximum * 230;
+  for (let tick = 0; tick <= 4; tick++) {
+    const value = maximum * tick / 4;
+    chart.appendChild(node("line", { x1: 60, x2: right, y1: y(value), y2: y(value), stroke: "#dfe7e3" }));
+    chart.appendChild(node("text", { x: 52, y: y(value) + 4, "text-anchor": "end", "font-size": 11, fill: "#66736c" }, `${value.toFixed(1)}×`));
+  }
+  if (references && values.length) [15, 20, 30].forEach((value) => {
+    chart.appendChild(node("line", { x1: 60, x2: right, y1: y(value), y2: y(value), stroke: "#8d9690", "stroke-dasharray": "5 4" }));
+    chart.appendChild(node("text", { x: right - 5, y: y(value) - 4, "text-anchor": "end", "font-size": 11, fill: "#66736c" }, `${value}× reference`));
+  });
+  series.forEach(([label, key, color]) => {
+    let path = "", open = false;
+    rows.forEach((row) => {
+      if (row[key] === null) { open = false; return; }
+      path += `${open ? "L" : "M"}${x(row.date)},${y(row[key])}`; open = true;
+      const marker = node("circle", { cx: x(row.date), cy: y(row[key]), r: 4, fill: color });
+      marker.appendChild(node("title", {}, `${row.date}: ${label} P/E ${number(row[key])}×; close ${number(row.price)} on ${row.priceDate}`));
+      chart.appendChild(marker);
+    });
+    chart.appendChild(node("path", { d: path, stroke: color, "stroke-width": 2, fill: "none" }));
+  });
+  rows.filter((_, index) => index % Math.max(1, Math.ceil(rows.length / (width < 600 ? 4 : 8))) === 0).forEach((row) => chart.appendChild(node("text", { x: x(row.date), y: 300, "text-anchor": "middle", "font-size": 11, fill: "#66736c" }, row.date.slice(0, 4))));
+  chart.appendChild(node("text", { x: 60, y: 321, "font-size": 11, fill: "#66736c" }, "Diluted: green · Basic: orange"));
+  chart.appendChild(node("text", { x: 60, y: 336, "font-size": 10, fill: "#66736c" }, "Annual EPS · approximate · stockvaluelens.com"));
+  document.querySelector("#pe-status").textContent = values.length ? `${rows.length} fiscal periods in the selected window. Gaps mean non-positive EPS or unavailable data. Ratios are uncapped.` : "P/E is unavailable in this window: positive annual EPS and an eligible fiscal-year-end price are required.";
+  const body = document.querySelector("#pe-observations");
+  body.textContent = "";
+  [...rows].reverse().forEach((row) => {
+    const tr = document.createElement("tr");
+    [row.date, row.priceDate || "Unavailable", number(row.basicPe), number(row.dilutedPe)].forEach((value) => {
+      const td = document.createElement("td"); td.textContent = value; tr.appendChild(td);
+    });
+    body.appendChild(tr);
+  });
+}
